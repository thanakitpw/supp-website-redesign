{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "supp-website-redesign",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "supp-website-redesign"
		}
	],
	// Custom domains own the apex + www DNS records (created by Cloudflare).
	"routes": [
		{ "pattern": "yourgoalswesupp.com", "custom_domain": true },
		{ "pattern": "www.yourgoalswesupp.com", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}
